{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palmshed.io/schemas/exec.schema.json",
  "title": "ExecOptionsAndResult",
  "description": "Schemas for execution input parameters and return results",
  "definitions": {
    "ExecOptions": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "memory": {
          "type": ["string", "number"],
          "description": "Memory limit for this execution (e.g. '256MB' or bytes). Overrides sandbox-level memory."
        },
        "cpuTimeLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "CPU time budget in milliseconds for this execution. Overrides sandbox-level cpuTimeLimit. Enforced across the process group."
        },
        "cpuQuota": {
          "type": "number",
          "minimum": 0.1,
          "description": "CPU core allocation quota for this execution (experimental)."
        },
        "workDir": {
          "type": "string",
          "description": "Working directory for this execution, relative to the sandbox root and contained to it (path traversal or absolute host paths are rejected with FS_ERROR). Created if absent."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables for this execution, overlaid onto the sandbox-level env. The host environment is not inherited wholesale (see sandbox.schema.json env)."
        }
      },
      "additionalProperties": false
    },
    "ExecResult": {
      "type": "object",
      "required": ["id", "exitCode", "stdout", "stderr", "durationMs", "timedOut"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique execution identifier (e.g. exec_9a8b7c6d)"
        },
        "exitCode": {
          "type": "integer"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "durationMs": {
          "type": "number"
        },
        "timedOut": {
          "type": "boolean"
        },
        "cpuTimeMs": {
          "type": "number",
          "description": "Total CPU time consumed by the execution process group in milliseconds (best-effort reporting)"
        },
        "metadata": {
          "$ref": "#/definitions/ExecutionMetadata"
        }
      },
      "additionalProperties": false
    },
    "ExecutionMetadata": {
      "type": "object",
      "required": ["id", "backend", "specVersion", "startedAt", "finishedAt", "durationMs", "exitCode", "timedOut"],
      "properties": {
        "id": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "specVersion": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "number"
        },
        "exitCode": {
          "type": "integer"
        },
        "timedOut": {
          "type": "boolean"
        },
        "cpuTimeMs": {
          "type": "number",
          "description": "Total CPU time consumed by the execution process group in ms (best-effort)"
        }
      },
      "additionalProperties": false
    }
  }
}
